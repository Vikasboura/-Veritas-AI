# ── API Security ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret-key-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://citebase:citebase@db:5432/citebase
# Sync URL used only by Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://citebase:citebase@db:5432/citebase

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM (OpenAI-compatible; never hardcode a provider) ───────────────────────
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=sk-placeholder
LLM_MODEL=gpt-4o-mini
LLM_JUDGE_MODEL=gpt-4o
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# ── Embeddings / Reranker ────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_VECTOR=20
RETRIEVAL_TOP_K_FTS=20
RETRIEVAL_TOP_N_RERANK=5
RETRIEVAL_RRF_K=60
REFUSAL_CONFIDENCE_THRESHOLD=0.35
HYBRID_ENABLED=true

# ── Semantic Cache ────────────────────────────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# ── PII Redaction ────────────────────────────────────────────────────────────
PII_REDACT=false

# ── Upload Limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,md,txt

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Tracing / PulseWatch ─────────────────────────────────────────────────────
PULSEWATCH_ENABLED=false
PULSEWATCH_API_KEY=

# ── Eval ─────────────────────────────────────────────────────────────────────
EVAL_JUDGE_MODEL=gpt-4o

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_API_KEY=changeme-mcp-api-key

# ── Misc ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
